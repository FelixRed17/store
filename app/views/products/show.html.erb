<% if flash[:notice] %>
  <p role="status"><%= flash[:notice] %></p>
<% end %>

<h1><%= @product.name %> </h1>

<% if @product.image.attached? %>
    <%= image_tag @product.image, alt: @product.name, class: "product-photo product-photo--large" %>
<% end %>

<h2> Product ID: <%= @product.id %></h2>

<% if authenticated? && Current.user.admin? %>

    <%= link_to "Edit Product", edit_product_path(@product) %>

    <%= link_to "Back to products", products_path %>

    <%= button_to "Delete product", 
                product_path(@product),
                method: :delete,
                form: {
                    data: {
                        turbo_confirm: "Delete this product?"
                    }
                }
    %>
<% end %>

<%= link_to "Order this product", new_product_order_path(@product), class: "Product-link" %>