<section class="form-card">
    <h1>Create your Numbi Chicken account</h1>

    <% if @user.errors.any? %>
        <div class="form-errors" role="alert">
            <p>Please check your details:</p>

            <ul>
                <%@user.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                <% end %>
            </ul>
        </div>
    <% end %>

    <%= form_with model: @user, url: registration_path do |form| %>
        <div>
            <%= form.label :email_address, "Email address" %>
            <%= form.email_field :email_address, required: true %>
        </div>

        <div>
            <%= form.label :password %>
            <%= form.password_field :password,
                                    required: true,
                                    autocomplete: "new-password"
            %>
        </div>

        <div>
            <%= form.label :password_confirmation, "Confirm password" %>
            <%= form.password_field :password_confirmation,
                                    required: true,
                                    autocomplete: "New password" 
            %>
        </div>

        <%= form.submit "Create account" %>
    <% end %>

    <%= link_to "Already have an account? Sign in", new_session_path %>
</section>